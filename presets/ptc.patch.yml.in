    - id: preset-ptc-workflow-review
      name: '@deepseek-ai/dsh-agent-preset'
      config:
        id: ptc-workflow-review
        name: "Ревью"
        description: "Независимая проверка файлов в рабочей папке. Только чтение."
        order: 2.56
        plugins:
          - id: persona
            name: '@deepseek-ai/dsh-persona'
            config:
              prefix: You are a coding agent powered by the {{model}} model.
          - id: agent-instructions
            name: '@deepseek-ai/dsh-agent-instructions'
            config:
              maxBytes: 65536
          - id: time-context
            name: '@deepseek-ai/dsh-time-context'
          - id: tool-fs
            name: '@deepseek-ai/dsh-tool-fs'
            config:
              # Set true to add the apply_patch tool beside edit.
              applyPatch: false
              readImage: false
              write: false
              edit: false
          - id: tool-fs-search
            name: '@deepseek-ai/dsh-tool-fs-search'
            config:
              sampleOverCapGlobResults: false
          - id: tool-executor-ptc
            name: '@deepseek-ai/dsh-tool-executor-ptc'
          - id: workflow-review-boundary
            name: "__DSH_PROFILE_URI__/local-plugins/ptc-workflow/reviewer.mjs"

    # BEGIN DSH PTC FULL MODEL VARIANTS
    - id: preset-ptc-workflow-claude-opus-5-5-full
      name: '@deepseek-ai/dsh-agent-preset'
      config:
        id: ptc-workflow-claude-opus-5-5-full
        name: "Claude Opus 5.5 Full"
        description: "Полный системный текст из Claude Code CLI и правила совместимости
          DSH."
        order: 2.27
        plugins:
          - *wf_persona
          - *wf_agent_instructions
          - *wf_time_context
          - *wf_tool_bash
          - *wf_tool_pwsh
          - *wf_tool_fs
          - *wf_tool_fs_search
          - *wf_tool_jobs
          - *wf_tool_schedule
          - *wf_skill_filesystem
          - *wf_tool_skill
          - *wf_command_goal
          - *wf_tool_goal
          - *wf_planning
          - *wf_compaction
          - *wf_delegation
          - *wf_tool_ask_user
          - *wf_tool_todo
          - *wf_tool_web
          - *wf_tool_executor_ptc
          - *wf_present
          - *wf_tool_office
          - *wf_tool_plugin_manager
          - *wf_tool_plugin_market
          - id: workflow-instructions
            name: '__DSH_PROFILE_URI__/local-plugins/ptc-workflow/full-prompts/index.mjs?v=3'
